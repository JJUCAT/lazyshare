{
  "slice": {
    "seq_len": 42,
    "jump_step": 42,
    "items": [
      "LU",
      "NC",
      "NV",
      "ATR",
      "NBull",
      "NBear",
      "TR",
      "IMV",
      "SIV"
    ],
    "label": [
      "峰值标签"
    ],
    "throw_last_one": true,
    "income_filter":{
      "time": 42,
      "increase": 0.2
    }
  },

  "data_source": "/Users/jucat/data/ashare/preprocessed",
  "dataset": "/Users/jucat/data/ashare/dataset",
  "validation": "/Users/jucat/data/ashare/validation",
  "models": "/Users/jucat/data/ashare/models",
  "weather": "/Users/jucat/data/ashare/share/weather.csv",

  "train": {
    "arch": "InceptionTimePlus",
    "tfms": "TSClassification",
    "batch_tfms": "",
    "batch_size": 128,
    "epochs": 30,
    "learning_rate": 0.001,
    "seed": 42,
    "validation_set": 0.1,
    "split": {
      "train": 0.6,
      "valid": 0.2,
      "test": 0.2
    },
    "loss_label_weight": {
      "T": 1.0,
      "B": 10.0,
      "N": 1.0
    },
    "decision_weight": "none",

    "early_stopping": {
      "monitor": "valid_loss",
      "patience": 5,
      "min_delta": 0.001
    },
    "save_best": true,
    "test": {
      "train_max": -1
    }
  },

  "evaluate": {
    "labels": [
      "T",
      "B"
    ],

    "items": [
      "accuracy",
      "precision",
      "recall",
      "f1_score",
      "roc_auc"
    ],

    "accuracy_interval": [
      0.99,
      0.95,
      0.90,
      0.85,
      0.80
    ],

    "weather": {
      "global": {
        "days": 15
      },
      "industrys": {
        "days": 15,
        "tops": 5
      },
      "shares": {
        "days": 5,
        "tops": 3
      }
    }
  }
}